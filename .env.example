# Database
DATABASE_URL=postgresql://uniswap3:uniswap3@localhost:5432/uniswap3

# API
API_HOST=0.0.0.0
API_PORT=3000
API_KEY=your-api-key-here

# gRPC
SYNCER_GRPC_URL=localhost:50051

# Syncer
SYNCER_PORT=50051
SYNCER_POOL_LVC_SIZE=1
SYNCER_POOL_TICK_RANGE_SIZE=1000

# Ethers JSON-RPC providers
ETHERS_ANKR_ENABLED=true
ETHERS_ANKR_URL=https://ethereum-rpc.publicnode.com
ETHERS_ANKR_API_KEY=
ETHERS_ANKR_TIMEOUT=10000
ETHERS_ANKR_PRIORITY=1

ETHERS_GETBLOCK_ENABLED=false
ETHERS_GETBLOCK_URL=https://eth.getblock.io/mainnet/
ETHERS_GETBLOCK_API_KEY=
ETHERS_GETBLOCK_TIMEOUT=10000
ETHERS_GETBLOCK_PRIORITY=2

ETHERS_LLAMANODES_ENABLED=false
ETHERS_LLAMANODES_URL=https://eth.llamarpc.com
ETHERS_LLAMANODES_API_KEY=
ETHERS_LLAMANODES_TIMEOUT=10000
ETHERS_LLAMANODES_PRIORITY=3

ETHERS_NOWNODES_ENABLED=false
ETHERS_NOWNODES_URL=https://eth.nownodes.io
ETHERS_NOWNODES_API_KEY=
ETHERS_NOWNODES_TIMEOUT=5000
ETHERS_NOWNODES_PRIORITY=4
