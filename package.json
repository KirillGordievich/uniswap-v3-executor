{
  "name": "uniswap3",
  "version": "2.0.0",
  "private": true,
  "description": "Uniswap v3 order executor — NestJS monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @uniswap3/api dev",
    "dev:syncer": "pnpm --filter @uniswap3/syncer dev",
    "start:api": "pnpm --filter @uniswap3/api start",
    "start:syncer": "pnpm --filter @uniswap3/syncer start",
    "lint": "eslint --ext .ts apps/ libs/",
    "lint:fix": "eslint --ext .ts apps/ libs/ --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage",
    "test:math": "jest --config libs/math/contracts/jest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cytoscape": "^3.30.0",
    "decimal.js": "^10.4.3",
    "ethers": "^5.7.2",
    "functional-red-black-tree": "^1.0.1",
    "keccak": "^3.0.4",
    "pino": "^9.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cytoscape": "^3.21.0",
    "@types/express": "^5.0.0",
    "@types/functional-red-black-tree": "^1.0.2",
    "@types/keccak": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
